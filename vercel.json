{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "redirects": [
    {
      "source": "/painel/:path*",
      "destination": "https://menudigital-8xuhohcp.manus.space/painel/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/manus-storage/:path*",
      "destination": "https://menudigital-8xuhohcp.manus.space/manus-storage/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://menudigital-8xuhohcp.manus.space/api/:path*"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
